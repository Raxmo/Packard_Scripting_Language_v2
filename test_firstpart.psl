// an example of a character definition allong witht the different data types and variable types
[[define: [character: main]]:
	[[set: [attribute: name]]: [text: Hero]],
	[[define: [container: bag]]:
		[[set: [attribute: sword]]: [item:]], // Items hold no data, they simply exist, or don't
		[[set: [attribute: books]]: [number: 3]],
		[[set: [attribute: money]]: [number: 10.25]],
		[[set: [attribute: isAvailable]]: [flag: on]]
	]
],
